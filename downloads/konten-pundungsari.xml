    <item>
      <title>Layanan</title>
      <link>https://marom2386-ops.github.io/website-desa-pundungsari/layanan/</link>
      <dc:creator>pengelola-desa</dc:creator>
      <content:encoded>&lt;!-- wp:paragraph --&gt;&lt;p&gt;Pilih layanan untuk melihat penjelasan dan bahan awal konsultasi. Persyaratan akhir, biaya sesuai ketentuan, dan waktu penyelesaian dikonfirmasi kepada petugas.&lt;/p&gt;&lt;!-- /wp:paragraph --&gt;&lt;!-- wp:details {"anchor":"surat-keterangan"} --&gt;&lt;details class="wp-block-details" id="surat-keterangan"&gt;&lt;summary&gt;Surat keterangan&lt;/summary&gt;&lt;!-- wp:paragraph --&gt;&lt;p&gt;Informasi dan pengurusan keterangan desa sesuai keperluan administrasi pemohon.&lt;/p&gt;&lt;!-- /wp:paragraph --&gt;&lt;!-- wp:heading {"level":3} --&gt;&lt;h3 class="wp-block-heading"&gt;Bahan awal untuk konsultasi&lt;/h3&gt;&lt;!-- /wp:heading --&gt;&lt;!-- wp:list --&gt;&lt;ul class="wp-block-list"&gt;&lt;!-- wp:list-item --&gt;&lt;li&gt;Identitas pemohon yang sudah dimiliki.&lt;/li&gt;&lt;!-- /wp:list-item --&gt;&lt;!-- wp:list-item --&gt;&lt;li&gt;Keperluan surat dan dokumen pendukung yang tersedia.&lt;/li&gt;&lt;!-- /wp:list-item --&gt;&lt;/ul&gt;&lt;!-- /wp:list --&gt;&lt;!-- wp:paragraph --&gt;&lt;p&gt;Pelayanan dan penerbitan dokumen mengikuti kewenangan masing-masing instansi.&lt;/p&gt;&lt;!-- /wp:paragraph --&gt;&lt;!-- wp:buttons --&gt;&lt;div class="wp-block-buttons"&gt;&lt;!-- wp:button --&gt;&lt;div class="wp-block-button"&gt;&lt;a class="wp-block-button__link wp-element-button" href="https://wa.me/6285236529079?text=Halo%20Pemerintah%20Desa%20Pundungsari%2C%20saya%20ingin%20menanyakan%20Surat%20keterangan."&gt;Tanyakan layanan ini&lt;/a&gt;&lt;/div&gt;&lt;!-- /wp:button --&gt;&lt;/div&gt;&lt;!-- /wp:buttons --&gt;&lt;/details&gt;&lt;!-- /wp:details --&gt;&lt;!-- wp:details {"anchor":"surat-keterangan-usaha"} --&gt;&lt;details class="wp-block-details" id="surat-keterangan-usaha"&gt;&lt;summary&gt;Surat Keterangan Usaha&lt;/summary&gt;&lt;!-- wp:paragraph --&gt;&lt;p&gt;Informasi pengurusan keterangan usaha melalui pelayanan desa.&lt;/p&gt;&lt;!-- /wp:paragraph --&gt;&lt;!-- wp:heading {"level":3} --&gt