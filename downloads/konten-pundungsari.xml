    <item>
      <title>Profil Desa</title>
      <link>https://marom2386-ops.github.io/website-desa-pundungsari/profil/</link>
      <dc:creator>pengelola-desa</dc:creator>
      <content:encoded>&lt;!-- wp:heading --&gt;&lt;h2 class="wp-block-heading"&gt;Desa Pundungsari&lt;/h2&gt;&lt;!-- /wp:heading --&gt;&lt;!-- wp:paragraph --&gt;&lt;p&gt;Desa Pundungsari berada di Kecamatan Tempursari, Kabupaten Lumajang, Provinsi Jawa Timur.&lt;/p&gt;&lt;!-- /wp:paragraph --&gt;&lt;!-- wp:heading --&gt;&lt;h2 class="wp-block-heading"&gt;Visi pembangunan desa&lt;/h2&gt;&lt;!-- /wp:heading --&gt;&lt;!-- wp:paragraph --&gt;&lt;p&gt;Periode RPJMDes 2020–2026&lt;/p&gt;&lt;!-- /wp:paragraph --&gt;&lt;!-- wp:paragraph --&gt;&lt;p&gt;Terwujudnya Masyarakat Pundungsari yang Berdaya Saing, Mandiri, Sejahtera, Berbudaya, Demokratis dan Bermartabat&lt;/p&gt;&lt;!-- /wp:paragraph --&gt;&lt;!-- wp:heading {"level":3} --&gt;&lt;h3 class="wp-block-heading"&gt;Misi&lt;/h3&gt;&lt;!-- /wp:heading --&gt;&lt;!-- wp:list {"ordered":true} --&gt;&lt;ol class="wp-block-list"&gt;&lt;!-- wp:list-item --&gt;&lt;li&gt;Meningkatkan SDM aparatur desa dan mewujudkan tata kelola pemerintahan yang lebih baik.&lt;/li&gt;&lt;!-- /wp:list-item --&gt;&lt;!-- wp:list-item --&gt;&lt;li&gt;Memberdayakan kelembagaan masyarakat dan Linmas desa.&lt;/li&gt;&lt;!-- /wp:list-item --&gt;&lt;!-- wp:list-item --&gt;&lt;li&gt;Meningkatkan sarana dan prasarana umum, pertanian, dan transportasi.&lt;/li&gt;&lt;!-- /wp:list-item --&gt;&lt;!-- wp:list-item --&gt;&lt;li&gt;Membina kerukunan umat beragama serta meningkatkan perekonomian masyarakat melalui pembinaan usaha kecil.&lt;/li&gt;&lt;!-- /wp:list-item --&gt;&lt;!-- wp:list-item --&gt;&lt;li&gt;Memberdayakan gotong royong dan karang taruna, serta melestarikan budaya dan kesenian daerah.&lt;/li&gt;&lt;!-- /wp:list-item --&gt;&lt;!-- wp:list-item --&gt;&lt;li&gt;Membentuk dan mengembangkan BUMDes serta mengoptimalkan sektor pertanian.&lt;/li&gt;&lt;!-- /wp:list-item --&gt;&lt;/ol&gt;&lt;!-- /wp:list --&gt;&lt;!-- wp:heading --&gt;&lt;h2 class="wp-block-heading"&gt;Potensi &amp; kegiatan masyarakat&lt;/h2&gt;&lt;!-- /wp:heading --&gt;&lt;!-- wp:paragraph --&gt;&lt;p&gt;Pertanian menjadi salah satu kegiatan masyarakat, antara lain komoditas cabai, pisang, dan palawija. Pengembangan usaha desa mencakup kegiatan BUMDesa Sumber Rejeki, pengelolaan Taman Pundungsari, dan usaha perikanan. Perpustakaan Desa Kasih Ibu menjadi bagian dari kegiatan literasi masyarakat.&lt;/p&gt;&lt;!-- /wp:paragraph --&gt;&lt;!-- wp:paragraph --&gt;&lt;p&gt;Untuk data statistik kependudukan dan wilayah terbaru, hubungi pelayanan informasi desa.&lt;/p&gt;&lt;!-- /wp:paragraph --&gt;</content:encoded>
      <excerpt:encoded />
